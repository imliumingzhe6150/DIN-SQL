正在调用模型，直接生成 SQL……
SELECT DISTINCT S.Fname, S.Age
FROM Student S
WHERE EXISTS (
    SELECT 1
    FROM Has_Pet HP
    JOIN Pets P ON HP.PetID = P.PetID
    WHERE HP.StuID = S.StuID
      AND P.PetType = 'Dog'
)
AND NOT EXISTS (
    SELECT 1
    FROM Has_Pet HP
    JOIN Pets P ON HP.PetID = P.PetID
    WHERE HP.StuID = S.StuID
      AND P.PetType = 'Cat'
);
